[
  {
    "layer": "top",
    "position": "top",
    "name": "main",
    "height": 32,
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,
    "reload_style_on_change": true,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/spotify", "cpu", "memory", "temperature", "disk", "network", "tray"],
    "hyprland/workspaces": { "disable-scroll-wraparound": true, "enable-bar-scroll": true, "format": "{icon}", "format-icons": { "default": "●", "active": "●", "special": "" } },
    "hyprland/window": { "format": "{title}", "max-length": 48, "icon": true, "icon-size": 16, "separate-outputs": true },
    "clock": {
      "interval": 1,
      "format": "  {:%H:%M}",
      "tooltip-format": "<b>{:%A, %d %B %Y}</b>\n\n<tt>{calendar}</tt>",
      "calendar": { "mode": "month", "weeks-pos": "right", "format": { "months": "<span color='#bd8857'><b>{}</b></span>", "days": "<span color='#e8dfd0'>{}</span>", "today": "<span color='#e2a35f'><b><u>{}</u></b></span>", "weekdays": "<span color='#a69a8b'>{}</span>", "weeks": "<span color='#8da39a'>W{}</span>" } }
    },
    "custom/spotify": { "exec": "playerctl -p spotify metadata --format '{{ artist }} — {{ title }}' 2>/dev/null", "exec-if": "playerctl -p spotify status 2>/dev/null | grep -Eq '^(Playing|Paused)$'", "interval": 2, "format": "󰓇  {}", "max-length": 36, "on-click": "playerctl -p spotify play-pause", "on-scroll-up": "playerctl -p spotify next", "on-scroll-down": "playerctl -p spotify previous" },
    "cpu": { "interval": 4, "format": "  {usage}%", "states": { "warning": 80, "critical": 95 } },
    "memory": { "interval": 4, "format": "󰍛  {percentage}%", "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB", "states": { "warning": 80, "critical": 95 } },
    "temperature": { "critical-threshold": 90, "interval": 4, "format": "{icon}  {temperatureC}°", "format-icons": ["", "", "", "", ""] },
    "disk": { "interval": 30, "format": "󰋊  {percentage_used}%", "tooltip-format": "{used} used · {free} free", "states": { "warning": 85, "critical": 95 } },
    "network": { "interval": 2, "format": "󰤭  Offline", "format-wifi": "{icon}  {bandwidthDownBits}", "format-ethernet": "󰈀  {bandwidthDownBits}", "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"], "tooltip-format-wifi": "{ifname}\n{essid} · {signalStrength}%\n↓ {bandwidthDownBits} · ↑ {bandwidthUpBits}", "tooltip-format-ethernet": "{ifname}\n↓ {bandwidthDownBits} · ↑ {bandwidthUpBits}" },
    "tray": { "icon-size": 16, "spacing": 8 }
  }
]
