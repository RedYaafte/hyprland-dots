[global]
    font = JetBrainsMono Nerd Font 12
    
    # Notification format
    format = "<b>%s</b>\n%b"
    
    # Geometry
    width = 350
    height = (0, 300)
    origin = top-center
    offset = (10, 10)
    
    # Progress bar
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    
    # Appearance
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    frame_width = 3
    corner_radius = 6
    
    # Icons
    icon_position = left
    max_icon_size = 64
    
    # Behavior
    show_age_threshold = 60
    sticky_history = yes
    history_length = 20
    
    # Mouse actions
    mouse_left_click = do_action
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#202030"
    foreground = "#94e2d5"
    frame_color = "#313244"
    timeout = 5

[urgency_normal]
    background = "#202030"
    foreground = "#b4befe"
    frame_color = "#313244"
    timeout = 10

[urgency_critical]
    background = "#202030"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
