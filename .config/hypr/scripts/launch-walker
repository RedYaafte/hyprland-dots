#!/usr/bin/env bash
# Start the local Walker stack without relying on Omarchy wrappers.
set -euo pipefail

is_running() {
  pgrep -f "$1" >/dev/null 2>&1
}

start_elephant() {
  if is_running '[e]lephant'; then
    return
  fi

  # The unit is installed with these dotfiles. The direct fallback keeps the
  # launcher usable if systemd --user is unavailable or has not been reloaded.
  systemctl --user start elephant.service >/dev/null 2>&1 || true
  if ! is_running '[e]lephant'; then
    setsid elephant >/dev/null 2>&1 &
  fi
}

start_walker_service() {
  if is_running '[w]alker --gapplication-service'; then
    return
  fi

  # Walker provides this user unit. Fall back to starting its service process
  # directly so a fresh Arch installation is still usable before enabling it.
  systemctl --user start app-walker@autostart.service >/dev/null 2>&1 || true
  if ! is_running '[w]alker --gapplication-service'; then
    setsid walker --gapplication-service >/dev/null 2>&1 &
  fi
}

start_elephant
start_walker_service

# Give newly spawned services a brief opportunity to expose their providers.
for _ in {1..20}; do
  is_running '[e]lephant' && is_running '[w]alker --gapplication-service' && break
  sleep 0.05
done

exec walker --width 644 --minheight 300 --maxheight 300 "$@"
